# Copy this file to `.env` (in this same server/ folder) and fill in the values.
# Never commit your real .env file.

# MongoDB connection string.
#   Local MongoDB:  mongodb://127.0.0.1:27017/subtrack
#   MongoDB Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/subtrack?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login tokens. Must be at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts before the user must sign in again.
JWT_EXPIRES_IN=7d

# Port for the API server.
PORT=5000

# Frontend URL(s) allowed to call the API (comma-separated).
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
